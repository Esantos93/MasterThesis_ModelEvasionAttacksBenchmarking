{
  "experiment": {
    "experiment_id": "exp_cicids2017_thursday_example_001",
    "description": "First narrow CICIDS2017 Thursday baseline modification benchmark.",
    "output_root": "/opt/tfm_benchmark/experiments"
  },
  "dataset": {
    "pcap_dir": "/data/cicids2017",
    "pcap_path": "/data/cicids2017/Thursday-WorkingHours.pcap",
    "flow_csv_dir": "/data/cicids2017/Flows",
    "attack_labels": [
      "Web Attack - Brute Force",
      "Web Attack - XSS",
      "Web Attack - Sql Injection",
      "Backdoor"
    ]
  },
  "snort": {
    "snort_binary": "/usr/local/bin/snort",
    "config_path": "/usr/local/etc/snort/snort.lua",
    "ruleset_path": "/usr/local/etc/snort/rules/cisco.rules",
    "plugin_path": "/usr/local/etc/snort/so_rules",
    "daq_dir": "/usr/local/lib/daq",
    "enable_builtin_rules": true
  },
  "llm": {
    "model_name": "Meta-Llama-3.1-8B-Instruct-Q4_K_M",
    "model_path": "/models/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf",
    "prompt_version": "baseline_v1",
    "temperature": 0.0,
    "top_p": 0.95,
    "max_tokens": 3000
  },
  "pipeline": {
    "target_os": "Ubuntu",
    "grouping_mode": "fixed_packet_count",
    "group_size_packets": 25,
    "validation_policy": "reject_invalid",
    "signature_mutation_weight": 0.0
  }
}
