{
  "policy_id": "conservative_v1",
  "description": "Assign packets to selected CICIDS2017 flows only when the 5-tuple mapping is unique or exactly one duplicate candidate matches the configured timestamp window.",
  "timestamp_window_seconds": 60,
  "csv_timestamp_offset_seconds": 0,
  "csv_timestamp_offsets_by_source_csv": {
    "Thursday-WorkingHours-Morning-WebAttacks.pcap_ISCX.csv": 10800,
    "Thursday-WorkingHours-Afternoon-Infiltration.pcap_ISCX.csv": 54000
  },
  "packet_statuses": [
    "mapped_unique",
    "mapped_duplicate_distinct_window",
    "ambiguous_duplicate_overlapping",
    "unassigned_time_window_mismatch",
    "unmapped"
  ],
  "rules": [
    {
      "case": "single_candidate_flow",
      "packet_mapping_status": "mapped_unique",
      "assign": "candidate_flow_ids"
    },
    {
      "case": "multiple_candidates_one_time_window_match",
      "packet_mapping_status": "mapped_duplicate_distinct_window",
      "assign": "time_window_matched_flow_id"
    },
    {
      "case": "multiple_candidates_multiple_time_window_matches",
      "packet_mapping_status": "ambiguous_duplicate_overlapping",
      "assign": []
    },
    {
      "case": "multiple_candidates_no_time_window_match",
      "packet_mapping_status": "unassigned_time_window_mismatch",
      "assign": []
    },
    {
      "case": "no_candidate_flow",
      "packet_mapping_status": "unmapped",
      "assign": []
    }
  ]
}
